rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny for all documents
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidCompoundId(id) {
      return id is string && id.size() > 0 && id.size() <= 260;
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }

    // Real authenticated user profiles (public read for global leaderboard and member directory)
    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if true;
      allow create: if isOwner(userId) && isValidId(userId) && request.resource.data.uid == userId;
      allow update: if isOwner(userId) && isValidId(userId) && request.resource.data.uid == userId;
      allow delete: if isOwner(userId) && isValidId(userId);

      // Private User Trajectory Data (Moves, streaks, achievements, focus history, personal progress)
      match /trajectory/{docId} {
        allow read, write: if isOwner(userId);
      }

      // Private Daily Moves Interactive Records (daily actions, workout, hydration, recovery)
      match /dailyMoves/{dateDoc} {
        allow read, write: if isOwner(userId);
      }

      // Private Notification Tokens & User Settings
      match /notifications/{docId} {
        allow read, write: if isOwner(userId);
      }

      // Private Move Reminders
      match /moveReminders/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Friend requests
    match /friendRequests/{requestId} {
      allow get: if isSignedIn() && isValidCompoundId(requestId) &&
        (resource == null || resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidCompoundId(requestId) &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.toUid != request.auth.uid;
      allow update: if isSignedIn() && isValidCompoundId(requestId) &&
        (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
      allow delete: if isSignedIn() && isValidCompoundId(requestId) &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    // Confirmed friendships
    match /friendships/{friendshipId} {
      allow get: if isSignedIn() && isValidCompoundId(friendshipId) &&
        (resource == null || request.auth.uid in resource.data.users);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidCompoundId(friendshipId) &&
        (request.auth.uid in request.resource.data.users);
      allow update: if isSignedIn() && isValidCompoundId(friendshipId) &&
        (request.auth.uid in resource.data.users);
      allow delete: if isSignedIn() && isValidCompoundId(friendshipId) &&
        (request.auth.uid in resource.data.users);
    }

    // Conversations / Direct rooms
    match /conversations/{conversationId} {
      allow get: if isSignedIn() && isValidCompoundId(conversationId) &&
        (resource == null || request.auth.uid in resource.data.participantIds);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidCompoundId(conversationId) &&
        (request.auth.uid in request.resource.data.participantIds);
      allow update: if isSignedIn() && isValidCompoundId(conversationId) &&
        (request.auth.uid in resource.data.participantIds);
      allow delete: if false;

      // Messages in conversation
      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidCompoundId(conversationId) && isValidId(messageId);
        allow list: if isSignedIn() && isValidCompoundId(conversationId);
        allow create: if isSignedIn() && isValidCompoundId(conversationId) && isValidId(messageId) &&
          request.resource.data.senderId == request.auth.uid;
        allow update: if isSignedIn() && isValidCompoundId(conversationId) && isValidId(messageId) &&
          (resource.data.senderId == request.auth.uid ||
           (resource.data.participantIds != null && request.auth.uid in resource.data.participantIds) ||
           (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds)) &&
          request.resource.data.senderId == resource.data.senderId &&
          request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isSignedIn() && isValidCompoundId(conversationId) && isValidId(messageId) &&
          resource.data.senderId == request.auth.uid;
      }
    }

    // Growth Circles (Quarter 4: Private Accountability & Collaboration)
    match /circles/{circleId} {
      allow get: if isSignedIn() && isValidId(circleId) &&
        (resource == null || request.auth.uid in resource.data.memberIds ||
         (resource.data.invitedFriendIds != null && request.auth.uid in resource.data.invitedFriendIds));
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(circleId) &&
        request.resource.data.creatorId == request.auth.uid &&
        request.auth.uid in request.resource.data.memberIds;
      allow update: if isSignedIn() && isValidId(circleId) &&
        (request.auth.uid in resource.data.memberIds ||
         (resource.data.invitedFriendIds != null && request.auth.uid in resource.data.invitedFriendIds));
      allow delete: if isSignedIn() && isValidId(circleId) &&
        resource.data.creatorId == request.auth.uid;

      // Shared Accountability Items (Moves & Goals intentionally shared with the Circle)
      match /sharedItems/{itemId} {
        allow get: if isSignedIn() && isValidId(circleId) && isValidId(itemId) &&
          (request.auth.uid in get(/databases/$(database)/documents/circles/$(circleId)).data.memberIds);
        allow list: if isSignedIn() && isValidId(circleId) &&
          (request.auth.uid in get(/databases/$(database)/documents/circles/$(circleId)).data.memberIds);
        allow create: if isSignedIn() && isValidId(circleId) && isValidId(itemId) &&
          (request.auth.uid in get(/databases/$(database)/documents/circles/$(circleId)).data.memberIds) &&
          request.resource.data.ownerId == request.auth.uid;
        allow update: if isSignedIn() && isValidId(circleId) && isValidId(itemId) &&
          (request.auth.uid in get(/databases/$(database)/documents/circles/$(circleId)).data.memberIds) &&
          request.resource.data.ownerId == resource.data.ownerId;
        allow delete: if isSignedIn() && isValidId(circleId) && isValidId(itemId) &&
          (request.auth.uid in get(/databases/$(database)/documents/circles/$(circleId)).data.memberIds) &&
          (resource.data.ownerId == request.auth.uid ||
           get(/databases/$(database)/documents/circles/$(circleId)).data.creatorId == request.auth.uid);
      }

      // Deep Work Sanctuary (Synchronized Group Focus Sessions)
      match /sanctuarySessions/{sessionId} {
        allow get: if isSignedIn() && isValidId(circleId) && isValidId(sessionId) &&
          (request.auth.uid in get(/databases/$(database)/documents/circles/$(circleId)).data.memberIds);
        allow list: if isSignedIn() && isValidId(circleId) &&
          (request.auth.uid in get(/databases/$(database)/documents/circles/$(circleId)).data.memberIds);
        allow create: if isSignedIn() && isValidId(circleId) && isValidId(sessionId) &&
          (request.auth.uid in get(/databases/$(database)/documents/circles/$(circleId)).data.memberIds) &&
          request.resource.data.hostId == request.auth.uid;
        allow update: if isSignedIn() && isValidId(circleId) && isValidId(sessionId) &&
          (request.auth.uid in get(/databases/$(database)/documents/circles/$(circleId)).data.memberIds);
        allow delete: if isSignedIn() && isValidId(circleId) && isValidId(sessionId) &&
          (resource.data.hostId == request.auth.uid ||
           get(/databases/$(database)/documents/circles/$(circleId)).data.creatorId == request.auth.uid);
      }
    }
  }
}
